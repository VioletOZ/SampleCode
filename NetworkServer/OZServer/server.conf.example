# OZServer 설정 — 이 파일을 server.conf로 복사한 뒤 값을 채운다(server.conf는 git에 올리지 않음).
# 형식: key = value. '#'으로 시작하는 줄은 주석(줄 중간 주석은 없음 — 값에 그대로 들어감).
# 생략한 키는 코드 기본값을 쓴다. 명령줄 인자 [io_threads] [db_workers] [log_level]가 있으면 그 값이 우선.
# 빌드 시 프로젝트 폴더의 server.conf가 x64\Debug, x64\Release로 복사된다(출력 폴더 쪽을 고치면 다음 빌드에 덮어씀).

port       = 12345
io_threads = 4
# debug | info | warn | error
log_level  = info
# 날짜별 로그 파일(logs/server_YYYY-MM-DD.log, error_YYYY-MM-DD.log) 보관 일수. 0이면 삭제 안 함
log_retention_days = 30

# MySQL X Plugin 포트(33060)
db.host     = 127.0.0.1
db.port     = 33060
db.user     = root
db.password =
db.database = account
# DB 워커 스레드 수 = MySQL 커넥션 수
db.workers  = 8

# Redis(유저 정보 캐시, 키 oz:*). 연결 실패 시 서버 종료
redis.host     = 127.0.0.1
redis.port     = 6379
redis.password =
# 0~15
redis.db       = 0
# 유저 정보 캐시 보관 시간(초, 60~2592000). 로그인할 때마다 다시 연장. 기본 86400(1일)
user_cache_ttl_seconds = 86400
